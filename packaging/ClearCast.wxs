<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ClearCast" Manufacturer="NCFX" Version="$(var.MsiVersion)"
           UpgradeCode="{6D6518A0-43F2-4C14-BD46-36C04820B3F1}" Scope="perUser">
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of ClearCast is already installed." />
    <!-- This private, self-contained payload can move to a lower-numbered
         supported dependency branch. Override Burn's muso before costing so
         component version rules cannot omit the exact validated binaries. -->
    <SetProperty Id="REINSTALLMODE" Value="amus" Before="CostInitialize"
                 Sequence="both" Condition="NOT Installed" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="ClearCast.ico" SourceFile="!(bindpath.Payload)\Assets\ClearCast.ico" />
    <Property Id="ARPPRODUCTICON" Value="ClearCast.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/NCFXZ/ClearCast/issues" />
    <!-- Match the original public installer's default context and directory.
         Burn 5 cannot safely manage an MSI whose install context changes. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ClearCast" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{BDA4BA07-86B2-4B3B-AF9C-4CFC55EAF247}">
        <Shortcut Id="ClearCastShortcut" Name="ClearCast" Target="[INSTALLFOLDER]ClearCast.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\NCFX\ClearCast" Name="Installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="ClearCast" Title="ClearCast" Level="1">
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.Payload)\**" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
