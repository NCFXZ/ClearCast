<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.3.1.0</Version>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\ClearCast.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Source-generated COM interop for the Composition blur effect description. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
    <ReceiverRuntimeDirectory Condition="'$(ReceiverRuntimeDirectory)' == ''">$(MSBuildProjectDirectory)\..\..\.runtime\receiver</ReceiverRuntimeDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableUiTests)' == 'true'">
    <DefineConstants>$(DefineConstants);CLEARCAST_UI_TESTS</DefineConstants>
    <InformationalVersion>$(Version)+ui-tests</InformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableUiTests)' == 'true'">
    <Compile Include="..\..\tests\ui\MainWindow.UiTests.cs" Link="Testing\MainWindow.UiTests.cs" />
    <Compile Include="..\..\tests\ui\MainWindow.MediaUiTests.cs" Link="Testing\MainWindow.MediaUiTests.cs" />
    <Compile Include="..\..\tests\ui\MainWindow.LyricsStressUiTests.cs" Link="Testing\MainWindow.LyricsStressUiTests.cs" />
    <Compile Include="..\..\tests\ui\MainWindow.LyricsBackpressureAuditUiTests.cs" Link="Testing\MainWindow.LyricsBackpressureAuditUiTests.cs" />
    <Compile Include="..\..\tests\ui\MainWindow.ControlAuditUiTests.cs" Link="Testing\MainWindow.ControlAuditUiTests.cs" />
    <Compile Include="..\..\tests\ui\MainWindow.LyricsPerformanceUiTests.cs" Link="Testing\MainWindow.LyricsPerformanceUiTests.cs" />
    <Compile Include="..\..\tests\ui\MainWindow.LyricsInputUiTests.cs" Link="Testing\MainWindow.LyricsInputUiTests.cs" />
    <Compile Include="..\..\tests\ui\MainWindow.BackpressureUiTests.cs" Link="Testing\MainWindow.BackpressureUiTests.cs" />
    <Compile Include="..\..\tests\ui\MainWindow.CompositorUiTests.cs" Link="Testing\MainWindow.CompositorUiTests.cs" />
    <Compile Include="..\..\tests\ui\MainWindow.BeatUiTests.cs" Link="Testing\MainWindow.BeatUiTests.cs" />
    <Compile Include="..\..\tests\ui\MainWindow.ConnectionUiTests.cs" Link="Testing\MainWindow.ConnectionUiTests.cs" />
    <Compile Include="..\..\tests\ui\MainWindow.StoreUiTests.cs" Link="Testing\MainWindow.StoreUiTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <Content Include="Assets\ClearCast.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\ClearCast.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\StoreLogo*.png;Assets\Square44x44Logo*.png;Assets\Square150x150Logo*.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\GitHubMark-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\MirroringAnimation\*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" TargetPath="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\shared\docs\legal\PRIVACY.md" Link="PRIVACY.md" TargetPath="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\shared\docs\legal\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" TargetPath="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(ReceiverRuntimeDirectory)\**\*"
          Link="receiver\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireReceiverRuntime" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(ReceiverRuntimeDirectory)\clearcast_receiver.dll')"
           Text="Build the ClearCast receiver runtime with scripts\native\Build-Receiver.ps1 before publishing." />
    <Error Condition="!Exists('$(ReceiverRuntimeDirectory)\gst-plugin-scanner.exe')"
           Text="The receiver runtime must include gst-plugin-scanner.exe. Rebuild it with scripts\native\Build-Receiver.ps1 before publishing." />
    <Error Condition="!Exists('$(ReceiverRuntimeDirectory)\security-dependencies-manifest.json')"
           Text="The receiver runtime must include the controlled dependency manifest. Build the security components and rebuild scripts\native\Build-Receiver.ps1 before publishing." />
    <Error Condition="!Exists('$(ReceiverRuntimeDirectory)\gstreamer-http-security-manifest.json') Or !Exists('$(ReceiverRuntimeDirectory)\LICENSE-GStreamerHttpSecurity.txt')"
           Text="Build the controlled HTTP source with scripts\native\Build-GStreamerHttpSecurity.ps1 and rebuild scripts\native\Build-Receiver.ps1 before publishing." />
  </Target>
  <!-- Unpackaged WinUI publish omits the app resource index. See WindowsAppSDK #6720. -->
  <Target Name="PublishWinUIResources"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)"
          Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" Condition="Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
