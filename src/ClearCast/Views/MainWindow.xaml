<Window
    x:Class="ClearCast.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClearCast"
    Title="ClearCast">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowLayout" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Invoked="PlaybackSpaceInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <Color x:Key="WindowBackdropTintColor">#BF202020</Color>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <Color x:Key="WindowBackdropTintColor">Transparent</Color>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <Color x:Key="WindowBackdropTintColor">Transparent</Color>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <x:Double x:Key="ActionControlMinWidth">130</x:Double>
                <x:Double x:Key="ActionControlMinHeight">32</x:Double>
                <Style x:Key="TextActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="MinWidth" Value="{StaticResource ActionControlMinWidth}" />
                    <Setter Property="MinHeight" Value="{StaticResource ActionControlMinHeight}" />
                </Style>
                <Style x:Key="AccentTextActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                    <Setter Property="MinWidth" Value="{StaticResource ActionControlMinWidth}" />
                    <Setter Property="MinHeight" Value="{StaticResource ActionControlMinHeight}" />
                </Style>
                <Style x:Key="PlayerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style x:Key="PlaybackSeekBarStyle" TargetType="local:PlaybackSeekBar">
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                    <Setter Property="SmallChange" Value="1" />
                    <Setter Property="LargeChange" Value="10" />
                    <Setter Property="Background" Value="{ThemeResource SliderTrackFill}" />
                    <Setter Property="Foreground" Value="{ThemeResource SliderTrackValueFill}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="local:PlaybackSeekBar">
                                <Grid x:Name="Track" Background="Transparent" MinHeight="32">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver" />
                                            <VisualState x:Name="Pressed" />
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Rectangle Height="4" Margin="10,0"
                                        Fill="{TemplateBinding Background}" RadiusX="2" RadiusY="2" VerticalAlignment="Center" />
                                    <Rectangle x:Name="ProgressFill" Width="0" Height="4" Fill="{TemplateBinding Foreground}"
                                        RadiusX="2" RadiusY="2" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False">
                                        <Rectangle.RenderTransform><TranslateTransform X="10" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Border x:Name="Thumb" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="10" IsHitTestVisible="False"
                                        BorderBrush="{ThemeResource SliderThumbBorderBrush}" BorderThickness="1">
                                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.Background>
            <SolidColorBrush Color="{ThemeResource WindowBackdropTintColor}" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:MusicBackdrop x:Name="MusicBackground" Grid.RowSpan="2" IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw" />

        <TitleBar x:Name="AppTitleBar" Title="ClearCast">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarIconMaxWidth">18</x:Double>
                <x:Double x:Key="TitleBarIconMaxHeight">18</x:Double>
                <Thickness x:Key="TitleBarIconMargin">0,0,8,0</Thickness>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/ClearCast.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="MainNavigation"
            Grid.Row="1"
            AlwaysShowHeader="False"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="880"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="304"
            PaneDisplayMode="Auto">
            <NavigationView.Resources>
                <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="MirrorNavigationItem" Content="{x:Bind Texts.Mirroring, Mode=OneWay}" Tag="mirror">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE703;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavigationItem" Content="{x:Bind Texts.Settings, Mode=OneWay}" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutNavigationItem" Content="{x:Bind Texts.About, Mode=OneWay}" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid x:Name="NavigationContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="WaitingPairing" MaxWidth="580" Margin="24,16,24,0" Padding="16,12" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind Texts.PairingCode, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="PairingPrompt" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="PinText" Grid.Column="1" VerticalAlignment="Center" FontSize="32" TextLineBounds="Tight"
                            FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive" />
                        <Button x:Name="PairingCloseButton" Grid.Column="2" Width="32" Height="32" Padding="0"
                            VerticalAlignment="Center" Style="{StaticResource SubtleButtonStyle}"
                            AutomationProperties.Name="{x:Bind Texts.DismissPairingCode, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Texts.DismissPairingCode, Mode=OneWay}" Click="PairingCloseClicked">
                            <Viewbox Width="16" Height="16">
                                <SymbolIcon Symbol="Cancel" />
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>
                <Frame x:Name="NavigationFrame" Grid.Row="1" IsNavigationStackEnabled="False"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <Grid x:Name="MirrorPage" Grid.Row="1" SizeChanged="PageSizeChanged">
                    <Grid x:Name="MirrorLayout" Margin="24,16,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <InfoBar x:Name="ReceiverInfoBar" MaxWidth="1000" Title="{x:Bind Texts.ReceiverError, Mode=OneWay}" Severity="Error" IsOpen="False">
                            <InfoBar.Resources>
                                <x:Double x:Key="ReceiverActionSize">32</x:Double>
                            </InfoBar.Resources>
                            <InfoBar.Template>
                                <!-- Keep actions outside the adaptive text panel so copy feedback cannot reflow the banner. -->
                                <ControlTemplate TargetType="InfoBar">
                                    <Border x:Name="ContentRoot" Background="{ThemeResource InfoBarErrorSeverityBackgroundBrush}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="InfoBarVisibility">
                                                <VisualState x:Name="InfoBarVisible" />
                                                <VisualState x:Name="InfoBarCollapsed">
                                                    <VisualState.Setters>
                                                        <Setter Target="ContentRoot.Visibility" Value="Collapsed" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                            <VisualStateGroup x:Name="CloseButtonVisibility">
                                                <VisualState x:Name="CloseButtonVisible" />
                                                <VisualState x:Name="CloseButtonCollapsed">
                                                    <VisualState.Setters>
                                                        <Setter Target="CloseButton.Visibility" Value="Collapsed" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Grid Padding="16,12" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid x:Name="ErrorIcon" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                                <FontIcon Glyph="{StaticResource InfoBarIconBackgroundGlyph}" FontSize="16"
                                                    Foreground="{ThemeResource InfoBarErrorSeverityIconBackground}" />
                                                <FontIcon Glyph="{StaticResource InfoBarErrorIconGlyph}" FontSize="16"
                                                    Foreground="{ThemeResource InfoBarErrorSeverityIconForeground}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock x:Name="Title" Text="{TemplateBinding Title}" FontWeight="SemiBold"
                                                    Foreground="{ThemeResource InfoBarTitleForeground}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="Message" Text="{TemplateBinding Message}"
                                                    Foreground="{ThemeResource InfoBarMessageForeground}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Content="{TemplateBinding ActionButton}" />
                                            <Button x:Name="CloseButton" Grid.Column="3" VerticalAlignment="Center" Margin="0" Padding="0"
                                                Width="{StaticResource ReceiverActionSize}" Height="{StaticResource ReceiverActionSize}"
                                                Command="{TemplateBinding CloseButtonCommand}" CommandParameter="{TemplateBinding CloseButtonCommandParameter}"
                                                Style="{TemplateBinding CloseButtonStyle}">
                                                <Button.Resources>
                                                    <ResourceDictionary>
                                                        <ResourceDictionary.ThemeDictionaries>
                                                            <ResourceDictionary x:Key="Default">
                                                                <StaticResource x:Key="ButtonBackground" ResourceKey="AppBarButtonBackground" />
                                                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AppBarButtonBackgroundPointerOver" />
                                                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AppBarButtonBackgroundPressed" />
                                                                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="AppBarButtonBackgroundDisabled" />
                                                                <StaticResource x:Key="ButtonForeground" ResourceKey="AppBarButtonForeground" />
                                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AppBarButtonForegroundPointerOver" />
                                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AppBarButtonForegroundPressed" />
                                                                <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="AppBarButtonForegroundDisabled" />
                                                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="AppBarButtonBorderBrush" />
                                                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AppBarButtonBorderBrushPointerOver" />
                                                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AppBarButtonBorderBrushPressed" />
                                                                <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="AppBarButtonBorderBrushDisabled" />
                                                            </ResourceDictionary>
                                                            <ResourceDictionary x:Key="Light">
                                                                <StaticResource x:Key="ButtonBackground" ResourceKey="AppBarButtonBackground" />
                                                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AppBarButtonBackgroundPointerOver" />
                                                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AppBarButtonBackgroundPressed" />
                                                                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="AppBarButtonBackgroundDisabled" />
                                                                <StaticResource x:Key="ButtonForeground" ResourceKey="AppBarButtonForeground" />
                                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AppBarButtonForegroundPointerOver" />
                                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AppBarButtonForegroundPressed" />
                                                                <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="AppBarButtonForegroundDisabled" />
                                                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="AppBarButtonBorderBrush" />
                                                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AppBarButtonBorderBrushPointerOver" />
                                                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AppBarButtonBorderBrushPressed" />
                                                                <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="AppBarButtonBorderBrushDisabled" />
                                                            </ResourceDictionary>
                                                            <ResourceDictionary x:Key="HighContrast">
                                                                <StaticResource x:Key="ButtonBackground" ResourceKey="AppBarButtonBackground" />
                                                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AppBarButtonBackgroundPointerOver" />
                                                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AppBarButtonBackgroundPressed" />
                                                                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="AppBarButtonBackgroundDisabled" />
                                                                <StaticResource x:Key="ButtonForeground" ResourceKey="AppBarButtonForeground" />
                                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AppBarButtonForegroundPointerOver" />
                                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AppBarButtonForegroundPressed" />
                                                                <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="AppBarButtonForegroundDisabled" />
                                                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="AppBarButtonBorderBrush" />
                                                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AppBarButtonBorderBrushPointerOver" />
                                                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AppBarButtonBorderBrushPressed" />
                                                                <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="AppBarButtonBorderBrushDisabled" />
                                                            </ResourceDictionary>
                                                        </ResourceDictionary.ThemeDictionaries>
                                                    </ResourceDictionary>
                                                </Button.Resources>
                                                <Viewbox Width="{StaticResource InfoBarCloseButtonGlyphSize}" Height="{StaticResource InfoBarCloseButtonGlyphSize}">
                                                    <SymbolIcon Symbol="{StaticResource InfoBarCloseButtonSymbol}" />
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </InfoBar.Template>
                            <InfoBar.ActionButton>
                                <Button x:Name="CopyErrorButton" Style="{StaticResource TextActionButtonStyle}"
                                    Height="{StaticResource ReceiverActionSize}" Padding="12,5" Click="CopyErrorClicked" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <Grid Grid.Row="1">
                            <Border x:Name="PlayerFrame" Background="Transparent" CornerRadius="8" Visibility="Collapsed"
                                DoubleTapped="PlayerFrameDoubleTapped" />
                            <Grid x:Name="VideoHostSlot" />
                            <ScrollViewer
                                x:Name="VideoPlaceholder"
                                HorizontalContentAlignment="Stretch"
                                HorizontalScrollMode="Disabled"
                                HorizontalScrollBarVisibility="Disabled"
                                SizeChanged="LandingViewportChanged"
                                VerticalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="LandingLayout">
                                    <StackPanel MaxWidth="570" Margin="8,28" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock
                                            AutomationProperties.HeadingLevel="Level1"
                                            Style="{StaticResource TitleTextBlockStyle}"
                                            Text="{x:Bind Texts.LandingHeading, Mode=OneWay}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <TextBlock x:Name="LandingDescription"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Texts.LandingDescription, Mode=OneWay}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <local:SvgFrameAnimation x:Name="LandingAnimation" MaxWidth="480" Margin="0,8,0,8"
                                            HorizontalAlignment="Center" IsHitTestVisible="False"
                                            AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock
                                            x:Name="LandingTitle"
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <Button x:Name="RetryReceiveButton" Content="{x:Bind Texts.RetryReceiver, Mode=OneWay}" HorizontalAlignment="Center"
                                            Click="RetryReceiveClicked" Style="{StaticResource AccentTextActionButtonStyle}" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <ScrollViewer x:Name="MusicPanel" Visibility="Collapsed"
                                HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled"
                                HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" SizeChanged="MusicViewportChanged">
                                <Grid x:Name="MusicLayout">
                                <StackPanel x:Name="MusicContent" MaxWidth="560" Margin="20,24" Spacing="12"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" SizeChanged="MusicContentSizeChanged">
                                    <Border x:Name="MusicArtworkFrame" Width="320" Height="320" CornerRadius="8" HorizontalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid>
                                            <FontIcon x:Name="MusicArtworkPlaceholder" Glyph="&#xE8D6;" FontSize="72"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Image x:Name="MusicArtwork" Stretch="Uniform" AutomationProperties.Name="{x:Bind Texts.MusicArtwork, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="MusicTitle" FontSize="22" FontWeight="SemiBold" MaxLines="2"
                                            TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                            AutomationProperties.LiveSetting="Polite" AutomationProperties.HeadingLevel="Level1" />
                                        <TextBlock x:Name="MusicArtist" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="MusicAlbum" TextAlignment="Center" MaxLines="1"
                                            Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <ProgressBar x:Name="MusicProgress" Minimum="0" Maximum="1" Value="0"
                                            AutomationProperties.Name="{x:Bind Texts.MusicProgress, Mode=OneWay}" />
                                        <local:PlaybackSeekBar x:Name="MusicSeekSlider" Minimum="0" Maximum="1000" Value="0" Visibility="Collapsed"
                                            Style="{StaticResource PlaybackSeekBarStyle}"
                                            AutomationProperties.Name="{x:Bind Texts.MusicProgress, Mode=OneWay}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="MusicElapsed" Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="MusicDuration" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel x:Name="MusicTransportControls" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                                        <Button x:Name="MusicPreviousButton" Width="44" Height="44" Padding="0" Click="MusicPreviousClicked"
                                            Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind Texts.MusicPrevious, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind Texts.MusicPrevious, Mode=OneWay}">
                                            <SymbolIcon Symbol="Previous" />
                                        </Button>
                                        <Button x:Name="MusicPlayPauseButton" Width="52" Height="52" Padding="0" Click="MusicPlayPauseClicked"
                                            Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center">
                                            <SymbolIcon x:Name="MusicPlayPauseIcon" Symbol="Pause" />
                                        </Button>
                                        <Button x:Name="MusicNextButton" Width="44" Height="44" Padding="0" Click="MusicNextClicked"
                                            Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind Texts.MusicNext, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind Texts.MusicNext, Mode=OneWay}">
                                            <SymbolIcon Symbol="Next" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="MusicControlHint" TextAlignment="Center" TextWrapping="Wrap"
                                        Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="MusicDisconnectButton" Content="{x:Bind Texts.Disconnect, Mode=OneWay}"
                                        Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Center" Click="DisconnectClicked" />
                                </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                        <Border x:Name="PlayerControls" Grid.Row="2" Margin="0,12,0,0" Padding="16,8,16,12"
                            CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed"
                            SizeChanged="PlayerControlsSizeChanged" GotFocus="PlayerControlsGotFocus"
                            PointerEntered="PlayerControlsPointerEntered" PointerExited="PlayerControlsPointerExited">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <Grid x:Name="VideoTransport" Visibility="Collapsed" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <TextBlock x:Name="VideoElapsedText" FontSize="12" VerticalAlignment="Center" />
                                    <local:PlaybackSeekBar x:Name="VideoSeekSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="0"
                                        Style="{StaticResource PlaybackSeekBarStyle}"
                                        AutomationProperties.Name="{x:Bind Texts.MusicProgress, Mode=OneWay}" />
                                    <TextBlock x:Name="VideoRemainingText" Grid.Column="2" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                                    <Button x:Name="PlayerStopButton" Style="{StaticResource SubtleButtonStyle}" Click="DisconnectClicked"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" MinHeight="36"
                                        Content="{x:Bind Texts.Disconnect, Mode=OneWay}" />
                                    <StackPanel x:Name="VideoPlaybackActions" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button x:Name="VideoSkipBackwardButton" Style="{StaticResource PlayerActionButtonStyle}" Click="VideoSkipBackwardClicked"
                                            AutomationProperties.Name="{x:Bind Texts.SkipBackward10, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind Texts.SkipBackward10, Mode=OneWay}">
                                            <Grid Width="24" Height="24">
                                                <Path Stroke="{Binding Foreground, ElementName=VideoSkipBackwardButton}" StrokeThickness="1.7"
                                                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                    Data="M21,11 A8,8 0 0 0 5,7 L2,10 M2,5 L2,10 L7,10" />
                                                <TextBlock Text="10" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="VideoPlayPauseButton" Style="{StaticResource PlayerActionButtonStyle}" Click="VideoPlayPauseClicked">
                                            <SymbolIcon x:Name="VideoPlayPauseIcon" Symbol="Pause" />
                                        </Button>
                                        <Button x:Name="VideoSkipForwardButton" Style="{StaticResource PlayerActionButtonStyle}" Click="VideoSkipForwardClicked"
                                            AutomationProperties.Name="{x:Bind Texts.SkipForward10, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind Texts.SkipForward10, Mode=OneWay}">
                                            <Grid Width="24" Height="24">
                                                <Path Stroke="{Binding Foreground, ElementName=VideoSkipForwardButton}" StrokeThickness="1.7"
                                                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                    Data="M3,11 A8,8 0 0 1 19,7 L22,10 M22,5 L22,10 L17,10" />
                                                <TextBlock Text="10" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel x:Name="PlayerActions" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button x:Name="RotateLeftButton" Style="{StaticResource PlayerActionButtonStyle}"
                                            AutomationProperties.Name="{x:Bind Texts.RotateLeft, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind Texts.RotateLeft, Mode=OneWay}" Click="RotateLeftClicked">
                                            <Path Width="22" Height="22" Stroke="{Binding Foreground, ElementName=RotateLeftButton}"
                                                StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                Data="M 4.5,12 A 7.5,7.5 0 1 1 12,19.5 M 2,10.5 L 4.5,13 L 7,10.5 M 13.6,12 A 1.6,1.6 0 1 1 10.4,12 A 1.6,1.6 0 1 1 13.6,12 Z" />
                                        </Button>
                                        <Button x:Name="RotateRightButton" Style="{StaticResource PlayerActionButtonStyle}"
                                            AutomationProperties.Name="{x:Bind Texts.RotateRight, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind Texts.RotateRight, Mode=OneWay}" Click="RotateRightClicked">
                                            <Path Width="22" Height="22" Stroke="{Binding Foreground, ElementName=RotateRightButton}"
                                                StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                Data="M 19.5,12 A 7.5,7.5 0 1 0 12,19.5 M 17,10.5 L 19.5,13 L 22,10.5 M 13.6,12 A 1.6,1.6 0 1 1 10.4,12 A 1.6,1.6 0 1 1 13.6,12 Z" />
                                        </Button>
                                        <Button x:Name="FullScreenButton" Style="{StaticResource PlayerActionButtonStyle}" Click="PlayerFullScreenClicked">
                                            <SymbolIcon x:Name="FullScreenIcon" Symbol="FullScreen" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="VideoControlHint" Grid.Row="2" Visibility="Collapsed" TextWrapping="Wrap"
                                    FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="SettingsPage" Grid.Row="1" SizeChanged="PageSizeChanged">
                    <Grid.Resources>
                        <Style TargetType="local:SettingsComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                            <Setter Property="MinWidth" Value="{StaticResource ActionControlMinWidth}" />
                            <Setter Property="MinHeight" Value="{StaticResource ActionControlMinHeight}" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                        </Style>
                    </Grid.Resources>
                    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="SettingsLayout" Margin="24,16,24,24">
                            <StackPanel MaxWidth="1000">
                                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind Texts.Settings, Mode=OneWay}" />
                                <StackPanel Margin="0,28,0,0" Spacing="4">
                                    <TextBlock Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level2"
                                        Text="{x:Bind Texts.GeneralHeading, Mode=OneWay}" />
                                    <Border Padding="16,12" MinHeight="68" CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid VerticalAlignment="Center" ColumnSpacing="16" ColumnDefinitions="24,*,Auto" RowDefinitions="Auto,Auto">
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE790;" FontSize="20" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Texts.ThemeLabel, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Texts.ThemeDescription, Mode=OneWay}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <local:SettingsComboBox x:Name="ThemeButton" Grid.Column="2"
                                                VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Texts.ThemeLabel, Mode=OneWay}"
                                                SelectionChangedTrigger="Committed" SelectionChanged="SettingsChoiceChanged">
                                                <ComboBoxItem x:Name="SystemThemeItem" Content="{x:Bind Texts.SystemDefault, Mode=OneWay}" />
                                                <ComboBoxItem x:Name="LightThemeItem" Content="{x:Bind Texts.LightTheme, Mode=OneWay}" />
                                                <ComboBoxItem x:Name="DarkThemeItem" Content="{x:Bind Texts.DarkTheme, Mode=OneWay}" />
                                            </local:SettingsComboBox>
                                        </Grid>
                                    </Border>
                                    <Border Padding="16,12" MinHeight="68" CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid VerticalAlignment="Center" ColumnSpacing="16" ColumnDefinitions="24,*,Auto" RowDefinitions="Auto,Auto">
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE774;" FontSize="20" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Texts.LanguageLabel, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Texts.LanguageDescription, Mode=OneWay}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <local:SettingsComboBox x:Name="LanguageButton" Grid.Column="2"
                                                VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Texts.LanguageLabel, Mode=OneWay}"
                                                SelectionChangedTrigger="Committed" SelectionChanged="SettingsChoiceChanged">
                                                <ComboBoxItem x:Name="ChineseLanguageItem" Content="{x:Bind Texts.ChineseLanguage, Mode=OneWay}" />
                                                <ComboBoxItem x:Name="EnglishLanguageItem" Content="{x:Bind Texts.EnglishLanguage, Mode=OneWay}" />
                                            </local:SettingsComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,20,0,0" Spacing="4">
                                    <TextBlock Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level2" Text="{x:Bind Texts.ReceivingHeading, Mode=OneWay}" />
                                    <Border Padding="16,12" MinHeight="68" CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid VerticalAlignment="Center" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7F8;" FontSize="20" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Texts.DecoderLabel, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Texts.DecoderDescription, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="DecoderFeedback" Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"
                                                    TextWrapping="Wrap" Visibility="Collapsed" />
                                            </StackPanel>
                                            <local:SettingsComboBox x:Name="DecoderButton" Grid.Column="2"
                                                VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Texts.DecoderLabel, Mode=OneWay}"
                                                SelectionChangedTrigger="Committed" SelectionChanged="SettingsChoiceChanged">
                                                <ComboBoxItem x:Name="AutoDecoderItem" Content="{x:Bind Texts.AutomaticDecoder, Mode=OneWay}" />
                                                <ComboBoxItem x:Name="SoftwareDecoderItem" Content="{x:Bind Texts.SoftwareDecoder, Mode=OneWay}" />
                                                <ComboBoxItem x:Name="HardwareDecoderItem" Content="{x:Bind Texts.HardwareDecoder, Mode=OneWay}" />
                                            </local:SettingsComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,20,0,0" Spacing="4">
                                    <TextBlock Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level2" Text="{x:Bind Texts.PlaybackHeading, Mode=OneWay}" />
                                    <Border Padding="16,12" MinHeight="68" CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid VerticalAlignment="Center" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE799;" FontSize="20" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Texts.DisplaySizeLabel, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Texts.DisplaySizeDescription, Mode=OneWay}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <local:SettingsComboBox x:Name="DisplaySizeButton" Grid.Column="2"
                                                VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Texts.DisplaySizeLabel, Mode=OneWay}"
                                                SelectionChangedTrigger="Committed" SelectionChanged="SettingsChoiceChanged">
                                                <ComboBoxItem x:Name="FitDisplayItem" Content="{x:Bind Texts.FitWindow, Mode=OneWay}" />
                                                <ComboBoxItem x:Name="OriginalDisplayItem" Content="{x:Bind Texts.OriginalSize, Mode=OneWay}" />
                                            </local:SettingsComboBox>
                                        </Grid>
                                    </Border>
                                    <Border Padding="16,12" MinHeight="68" CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="16">
                                            <SymbolIcon Symbol="FullScreen" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Texts.AutoFullScreenLabel, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Texts.AutoFullScreenDescription, Mode=OneWay}" TextWrapping="Wrap"
                                                    Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="AutoFullScreenToggle" Grid.Column="2" VerticalAlignment="Center"
                                                MinWidth="0" HorizontalAlignment="Right" Loaded="AutoFullScreenLoaded"
                                                OnContent="" OffContent="" Toggled="AutoFullScreenToggled"
                                                AutomationProperties.Name="{x:Bind Texts.AutoFullScreenLabel, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="SettingsSaveHint" Visibility="Collapsed"
                                        Text="{x:Bind Texts.PreferencesSaveError, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Margin="0,20,0,0" Spacing="4">
                                    <TextBlock Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level2" Text="{x:Bind Texts.PairingHeading, Mode=OneWay}" />
                                    <local:SettingsExpander x:Name="PairingExpander" MinHeight="68" Padding="0" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind Texts.SavedPairings, Mode=OneWay}"
                                        HeaderBackground="{ThemeResource ExpanderHeaderBackground}"
                                        HeaderPointerOverBackground="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <local:SettingsExpander.Resources>
                                            <SolidColorBrush x:Key="ExpanderChevronPointerOverBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ExpanderChevronPressedBackground" Color="Transparent" />
                                        </local:SettingsExpander.Resources>
                                        <local:SettingsExpander.Header>
                                            <Grid Margin="0,12,12,12" ColumnDefinitions="24,*" ColumnSpacing="16">
                                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72E;" FontSize="20" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Texts.SavedPairings, Mode=OneWay}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Texts.SavedPairingsDescription, Mode=OneWay}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </local:SettingsExpander.Header>
                                        <StackPanel>
                                            <ItemsControl x:Name="PairingDeviceList" HorizontalContentAlignment="Stretch">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:PairingDeviceRow">
                                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                            <Grid Padding="56,8,44,8" MinHeight="52" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                <Button Grid.Column="1" Style="{StaticResource TextActionButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                    Content="{x:Bind RemoveText}" AutomationProperties.Name="{x:Bind RemoveAutomationName}"
                                                                    Click="RemoveDevicePairingClicked" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Padding="56,8,44,8" MinHeight="52" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock x:Name="PairingListFooter" TextWrapping="Wrap"
                                                    VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Button x:Name="RepairPairingButton" Grid.Column="1" Style="{StaticResource TextActionButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Content="{x:Bind Texts.ClearPairings, Mode=OneWay}" IsEnabled="False" Click="RepairPairingClicked" />
                                            </Grid>
                                        </StackPanel>
                                    </local:SettingsExpander>
                                    <TextBlock x:Name="PairingResetFeedback" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"
                                        Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="AboutPage" Grid.Row="1" SizeChanged="PageSizeChanged">
                    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="AboutLayout" Margin="24,16,24,24">
                            <StackPanel MaxWidth="1000" Spacing="28">
                                <TextBlock x:Name="AboutHeading" AutomationProperties.HeadingLevel="Level1"
                                    Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind Texts.About, Mode=OneWay}" />
                                <StackPanel Spacing="12">
                                    <local:SettingsExpander x:Name="AboutExpander" MinHeight="68" Padding="0" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" AutomationProperties.Name="ClearCast"
                                        HeaderBackground="{ThemeResource ExpanderHeaderBackground}"
                                        HeaderPointerOverBackground="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <local:SettingsExpander.Resources>
                                            <Thickness x:Key="ExpanderChevronMargin">0,0,8,0</Thickness>
                                            <SolidColorBrush x:Key="ExpanderChevronPointerOverBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ExpanderChevronPressedBackground" Color="Transparent" />
                                        </local:SettingsExpander.Resources>
                                        <local:SettingsExpander.Header>
                                            <Grid Margin="0,12,0,12" ColumnDefinitions="28,*,Auto" ColumnSpacing="16">
                                                <Image Width="28" Height="28" VerticalAlignment="Center" Source="ms-appx:///Assets/ClearCast.png" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock x:Name="AboutAppName" Text="ClearCast" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="AboutLicenseText" Text="{x:Bind Texts.AboutLicense, Mode=OneWay}"
                                                        Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock x:Name="AboutVersionLabel" Grid.Column="2" Text="{x:Bind Texts.AboutVersion}"
                                                    VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </local:SettingsExpander.Header>
                                        <HyperlinkButton x:Name="AboutRepositoryLink" Margin="48,8,44,8" Padding="12,6"
                                            HorizontalAlignment="Left" Content="{x:Bind Texts.AboutRepositoryLinkText, Mode=OneWay}"
                                            NavigateUri="https://github.com/NCFXZ/ClearCast" />
                                    </local:SettingsExpander>
                                    <HyperlinkButton x:Name="AboutIssueLink" Padding="0" HorizontalAlignment="Right"
                                        AutomationProperties.Name="{x:Bind Texts.AboutReportIssue, Mode=OneWay}" NavigateUri="https://github.com/NCFXZ/ClearCast/issues/new">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Width="16" Height="16" VerticalAlignment="Center"
                                                Data="M 6.766 11.328
                                                    c -2.063 -.25 -3.516 -1.734 -3.516 -3.656 0 -.781 .281 -1.625 .75 -2.188
                                                      -.203 -.515 -.172 -1.609 .063 -2.062 .625 -.078 1.468 .25 1.968 .703
                                                      .594 -.187 1.219 -.281 1.985 -.281 .765 0 1.39 .094 1.953 .265
                                                      .484 -.437 1.344 -.765 1.969 -.687 .218 .422 .25 1.515 .046 2.047
                                                      .5 .593 .766 1.39 .766 2.203 0 1.922 -1.453 3.375 -3.547 3.64
                                                      .531 .344 .89 1.094 .89 1.954
                                                    v 1.625 c 0 .468 .391 .734 .86 .547
                                                    C 13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031
                                                    a 7.88 7.88 0 0 0 5.172 7.422 c .422 .156 .828 -.125 .828 -.547 v -1.25
                                                    c -.219 .094 -.5 .156 -.75 .156 -1.031 0 -1.64 -.562 -2.078 -1.609
                                                      -.172 -.422 -.36 -.672 -.719 -.719 -.187 -.015 -.25 -.093 -.25 -.187
                                                      0 -.188 .313 -.328 .625 -.328 .453 0 .844 .281 1.25 .86
                                                      .313 .452 .64 .655 1.031 .655 s .641 -.14 1 -.5 c .266 -.265 .47 -.5 .657 -.656 z" />
                                            <TextBlock Text="{x:Bind Texts.AboutReportIssue, Mode=OneWay}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </NavigationView>
    </Grid>
</Window>
