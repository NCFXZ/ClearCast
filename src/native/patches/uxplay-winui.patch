+++ b/winui_video_host.h
@@ -0,0 +1,104 @@
+/*
+ * Windows video host for the UxPlay ClearCast integration.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#pragma once
+
+#include <windows.h>
+
+struct WinUiVideoHostStart {
+    HWND parent;
+    HANDLE ready;
+    HWND child;
+    DWORD error;
+};
+
+static LRESULT CALLBACK winui_video_host_proc(HWND window, UINT message, WPARAM wparam, LPARAM lparam) {
+    switch (message) {
+    case WM_TIMER: {
+        RECT parent_rect;
+        RECT child_rect;
+        if (!GetClientRect(GetParent(window), &parent_rect)) {
+            DestroyWindow(window);
+        } else if (GetClientRect(window, &child_rect) &&
+                   (child_rect.right != parent_rect.right || child_rect.bottom != parent_rect.bottom)) {
+            SetWindowPos(window, nullptr, 0, 0, parent_rect.right, parent_rect.bottom,
+                         SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+        }
+        return 0;
+    }
+    case WM_DESTROY:
+        PostQuitMessage(0);
+        return 0;
+    case WM_SETCURSOR:
+        if (LOWORD(lparam) == HTCLIENT) {
+            SetCursor(LoadCursor(nullptr, IDC_ARROW));
+            return TRUE;
+        }
+        break;
+    }
+    return DefWindowProcW(window, message, wparam, lparam);
+}
+
+static DWORD WINAPI winui_video_host_thread(void *data) {
+    auto *start = static_cast<WinUiVideoHostStart *>(data);
+    const HWND parent = start->parent;
+    const auto parent_dpi = GetWindowDpiAwarenessContext(parent);
+    if (parent_dpi) {
+        SetThreadDpiAwarenessContext(parent_dpi);
+    }
+    const HINSTANCE instance = GetModuleHandleW(nullptr);
+    const wchar_t *class_name = L"ClearCastVideoHost";
+    WNDCLASSW window_class = {};
+    window_class.lpfnWndProc = winui_video_host_proc;
+    window_class.hInstance = instance;
+    window_class.hbrBackground = static_cast<HBRUSH>(GetStockObject(BLACK_BRUSH));
+    window_class.lpszClassName = class_name;
+
+    HWND window = nullptr;
+    RECT rect;
+    if (GetClientRect(parent, &rect) && RegisterClassW(&window_class)) {
+        window = CreateWindowExW(WS_EX_NOPARENTNOTIFY, class_name, L"",
+                                 WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN | WS_CLIPSIBLINGS,
+                                 0, 0, rect.right, rect.bottom, parent, nullptr, instance, nullptr);
+    }
+    DWORD error = window ? ERROR_SUCCESS : GetLastError();
+    if (window && !SetTimer(window, 1, 50, nullptr)) {
+        error = GetLastError();
+        DestroyWindow(window);
+        window = nullptr;
+    }
+    start->child = window;
+    start->error = error;
+    SetEvent(start->ready);
+    if (!window) {
+        return 0;
+    }
+
+    MSG message;
+    while (GetMessageW(&message, nullptr, 0, 0) > 0) {
+        TranslateMessage(&message);
+        DispatchMessageW(&message);
+    }
+    return 0;
+}
+
+static HWND create_winui_video_host(HWND parent) {
+    HANDLE ready = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    if (!ready) {
+        return nullptr;
+    }
+    WinUiVideoHostStart start = { parent, ready, nullptr, ERROR_SUCCESS };
+    HANDLE thread = CreateThread(nullptr, 0, winui_video_host_thread, &start, 0, nullptr);
+    if (!thread) {
+        const DWORD error = GetLastError();
+        CloseHandle(ready);
+        SetLastError(error);
+        return nullptr;
+    }
+    WaitForSingleObject(ready, INFINITE);
+    CloseHandle(thread);
+    CloseHandle(ready);
+    SetLastError(start.error);
+    return start.child;
+}
