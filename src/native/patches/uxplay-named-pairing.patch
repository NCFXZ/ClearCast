+/* pairing_digest_verify trusts its input. Pass it only the unqualified RFC 2069
+ * form, walked exactly as it will parse it, answering the current nonce. */
+static bool clearcast_pairing_digest_shape(const char *authorization, const char *nonce) {
+    static const char *const fields[] = { "username", "realm", "nonce", "uri", "response" };
+    if (strstr(authorization, "qop")) return false;
+    for (int i = 0; i < 5; ++i) {
+        const char *value = strstr(authorization, fields[i]);
+        if (!value || !(value = strchr(value + strlen(fields[i]), '"'))) return false;
+        const char *end = strchr(++value, '"');
+        if (!end) return false;
+        if (i == 2 && ((size_t) (end - value) != strlen(nonce) || memcmp(value, nonce, end - value))) return false;
+        authorization = end + 1;
+    }
+    return true;
