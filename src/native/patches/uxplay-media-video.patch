+static bool clearcast_http_number(const char *url, const char *prefix, double *value) {
+    if (!url || strncmp(url, prefix, strlen(prefix))) return false;
+    const char *number = url + strlen(prefix);
+    char *end = NULL;
+    *value = strtod(number, &end);
+    return end && end != number && !*end && isfinite(*value) && *value >= 0 && *value <= 7 * 86400;
+}
