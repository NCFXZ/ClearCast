<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.1.0</Version>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\ClearCast.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);.runtime\**;.clearcast-state\**;bin\**;obj\**</DefaultItemExcludes>
    <ReceiverRuntimeDirectory Condition="'$(ReceiverRuntimeDirectory)' == ''">$(MSBuildProjectDirectory)\.runtime\receiver</ReceiverRuntimeDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableUiTests)' == 'true'">
    <DefineConstants>$(DefineConstants);CLEARCAST_UI_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableUiTests)' != 'true'">
    <Compile Remove="MainWindow.UiTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <Content Include="Assets\ClearCast.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\ClearCast.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\GitHubMark-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\MirroringAnimation\*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(ReceiverRuntimeDirectory)\**\*"
          Link="receiver\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireReceiverRuntime" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(ReceiverRuntimeDirectory)\clearcast_receiver.dll')"
           Text="Build the ClearCast receiver runtime with native\Build-Receiver.ps1 before publishing." />
    <Error Condition="!Exists('$(ReceiverRuntimeDirectory)\gst-plugin-scanner.exe')"
           Text="The receiver runtime must include gst-plugin-scanner.exe. Rebuild it with native\Build-Receiver.ps1 before publishing." />
    <Error Condition="!Exists('$(ReceiverRuntimeDirectory)\security-dependencies-manifest.json')"
           Text="The receiver runtime must include the controlled dependency manifest. Build the security components and rebuild native\Build-Receiver.ps1 before publishing." />
  </Target>
  <!-- Unpackaged WinUI publish omits the app resource index. See WindowsAppSDK #6720. -->
  <Target Name="PublishWinUIResources"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)"
          Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" Condition="Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
